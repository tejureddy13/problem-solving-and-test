    public int maxSubArray(int[] nums) {
        // kadanes algo
        //O(n)
        //O(1)
        int n=nums.length;
         int maxsum=Integer.MIN_VALUE;
         int cs=0;
        for(int i=0;i<n;i++){
            cs +=nums[i];
            maxsum =Math.max(cs,maxsum);
           if(cs<0){
                cs=0;
           }
        }
        return maxsum;
    }
}
