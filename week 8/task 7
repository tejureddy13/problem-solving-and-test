import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int t = s.nextInt();
        String [] pair_left = new String[t];
        String [] pair_right = new String[t];
        
        for (int i = 0; i < t; i++) {
            pair_left[i] = s.next();
            pair_right[i] = s.next();
        }

        // Write your code here
        // Using a HashSet to keep track of unique string pairs
        HashSet<String> uniquePairs = new HashSet<>();
        
        for (int i = 0; i < t; i++) {
            // Combine both strings with a unique delimiter to form a single unique key
            uniquePairs.add(pair_left[i] + " " + pair_right[i]);
            // Print the current size of the set
            System.out.println(uniquePairs.size());
        }
    }
}
